# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-side only; bypasses Row Level Security)
SUPABASE_SECRET_KEY=

# AI (server-side only — never exposed to the browser)
OPENROUTER_API_KEY=

# Payments (§6.185). Server only — never NEXT_PUBLIC_.
# STRIPE_SECRET_KEY: Stripe → Developers → API keys (sk_test_… while testing, sk_live_… when selling).
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# BILLING_DB_SECRET: a long random password you make up (40+ characters). Its sha256 hash goes into
# billing_private.webhook_secret in Supabase (see migration 0062). It can only record billing.
BILLING_DB_SECRET=
